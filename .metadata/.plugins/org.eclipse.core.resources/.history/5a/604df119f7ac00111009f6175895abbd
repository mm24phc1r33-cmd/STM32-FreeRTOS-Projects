/**
 * @brief Thread-safe logging function for tasks.
 */
void printmsg(const char *msg)
{
    if (xLogStreamBuffer != NULL)
    {
        xStreamBufferSend(xLogStreamBuffer, msg, strlen(msg), portMAX_DELAY);
    }
}

/**
 * @brief Lock-free, non-blocking logging function for ISRs.
 */
void printmsgFromISR(const char *msg)
{
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;
    if (xLogStreamBuffer != NULL)
    {
        /* Send to stream buffer without blocking */
        xStreamBufferSendFromISR(xLogStreamBuffer, msg, strlen(msg), &xHigherPriorityTaskWoken);
        portEND_SWITCHING_ISR(xHigherPriorityTaskWoken);
    }
}

static void prvSetupSoftwareInterrupt(void)
{
    NVIC_SetPriority(EXTI15_10_IRQn, configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY);
    NVIC_EnableIRQ(EXTI15_10_IRQn);
}
/* USER CODE END 0 */

int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();

  /* USER CODE BEGIN 2 */
    CoreDebug->DEMCR |= (1 << 24);
    DWT->CYCCNT = 0;
    DWT->CTRL |= (1 << 0);

    SEGGER_SYSVIEW_Conf();
    SEGGER_SYSVIEW_Start();

    /* Create non-blocking Stream Buffer for thread-safe UART logging */
    xLogStreamBuffer = xStreamBufferCreate(LOG_STREAM_BUFFER_SIZE, 1);

    /* Create counting semaphore */
    xCountingSemaphore = xSemaphoreCreateCounting(MAX_EVENT_COUNT, INITIAL_EVENT_COUNT);

    if ((xCountingSemaphore != NULL) && (xLogStreamBuffer != NULL))
    {
        prvSetupSoftwareInterrupt();

        /* Create Logger Task (Priority 0) */
        xTaskCreate(Logger_task, "Logger", 256, NULL,
                    LOGGER_TASK_PRIORITY, &xLoggerTaskHandle);

        /* Create Handler Task (Priority 1) */
        xTaskCreate(Handler_task, "Handler", 256, NULL,
                    HANDLER_TASK_PRIORITY, &xHandlerTaskHandle);

        /* Create Periodic Task (Priority 3) */
        xTaskCreate(Periodic_task, "Periodic", 256, NULL,
                    PERIODIC_TASK_PRIORITY, &xPeriodicTaskHandle);

        printmsg("Demo of counting semaphore with thread-safe logging\r\n");

        /* Start native FreeRTOS scheduler */
        vTaskStartScheduler();
    }

    /* Fallback if memory allocation fails */
    for (;;);
  /* USER CODE END 2 */
}

