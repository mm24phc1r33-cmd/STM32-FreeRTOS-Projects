/*
 * Counting semaphore used to latch events from the fast triggering
 * interrupt. Unlike a binary semaphore, it will not lose an event if
 * several interrupts fire before the handler task gets a chance to run -
 * each ISR "give" increments the count, and the handler task drains the
 * count one "take" at a time.
 */
SemaphoreHandle_t xCountingSemaphore;

