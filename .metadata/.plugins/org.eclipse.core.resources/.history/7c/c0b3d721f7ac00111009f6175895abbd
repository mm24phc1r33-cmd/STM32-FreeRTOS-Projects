/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* Configure the system clock */
  SystemClock_Config();

  /* Initialize configured peripherals */
  MX_GPIO_Init();

  /* USER CODE BEGIN 2 */
    CoreDebug->DEMCR |= (1 << 24);
    DWT->CYCCNT = 0;
    DWT->CTRL |= (1 << 0);

    SEGGER_SYSVIEW_Conf();
    SEGGER_SYSVIEW_Start();

    /* Create non-blocking Stream Buffer for thread-safe UART logging */
    xLogStreamBuffer = xStreamBufferCreate(LOG_STREAM_BUFFER_SIZE, 1);

    /* Create counting semaphore */
    xCountingSemaphore = xSemaphoreCreateCounting(MAX_EVENT_COUNT, INITIAL_EVENT_COUNT);

    if ((xCountingSemaphore != NULL) && (xLogStreamBuffer != NULL))
    {
        prvSetupSoftwareInterrupt();

        /* Create 'Logger' task (Priority 0) */
        xTaskCreate(Logger_task, "Logger", 256, NULL,
                    LOGGER_TASK_PRIORITY, &xLoggerTaskHandle);

        /* Create 'Handler' task (Priority 1) */
        xTaskCreate(Handler_task, "Handler", 256, NULL,
                    HANDLER_TASK_PRIORITY, &xHandlerTaskHandle);

        /* Create 'Periodic' task (Priority 3) */
        xTaskCreate(Periodic_task, "Periodic", 256, NULL,
                    PERIODIC_TASK_PRIORITY, &xPeriodicTaskHandle);

        printmsg("Demo of usage of counting semaphore with thread-safe logging\r\n");

        /* Start the FreeRTOS scheduler */
        vTaskStartScheduler();
    }
    else
    {
        /* Heap allocation failed */
    }

    /* Infinite loop if scheduler fails to start */
    for (;;);
  /* USER CODE END 2 */
}

