/* ---------------- Logger Task ---------------- */
static void Logger_task(void *pvParameters)
{
    char rx_buf[64];
    size_t xReceivedBytes;

    for (;;)
    {
        xReceivedBytes = xStreamBufferReceive(xLogStreamBuffer,
                                             rx_buf,
                                             sizeof(rx_buf) - 1,
                                             portMAX_DELAY);
        if (xReceivedBytes > 0)
        {
            rx_buf[xReceivedBytes] = '\0';
            HAL_UART_Transmit(&huart2, (uint8_t*)rx_buf, xReceivedBytes, HAL_MAX_DELAY);
        }
    }
}

/* ---------------- Handler Task ---------------- */
static void Handler_task(void *pvParameters)
{
    char msg[64];

    for (;;)
    {
        /* Block until an event is latched by the semaphore */
        xSemaphoreTake(xCountingSemaphore, portMAX_DELAY);

        snprintf(msg, sizeof(msg), "Handler task - Processing event.\r\n");
        printmsg(msg);
    }
}

/* ---------------- Periodic Task ---------------- */
static void Periodic_task(void *pvParameters)
{
    char msg[64];

    for (;;)
    {
        vTaskDelay(pdMS_TO_TICKS(500));

        snprintf(msg, sizeof(msg), "Periodic task - Pending the interrupt.\r\n");
        printmsg(msg);

        /* Trigger software interrupt */
        NVIC_SetPendingIRQ(EXTI15_10_IRQn);

        snprintf(msg, sizeof(msg), "Periodic task - Resuming.\r\n");
        printmsg(msg);
    }
}

/* ---------------- Fast Triggering Interrupt (ISR) ---------------- */
void EXTI15_10_IRQHandler(void)
{
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;

    printmsgFromISR("==>Button_Handler\r\n");

    /* Increment counting semaphore multiple times to simulate burst events */
    xSemaphoreGiveFromISR(xCountingSemaphore, &xHigherPriorityTaskWoken);
    xSemaphoreGiveFromISR(xCountingSemaphore, &xHigherPriorityTaskWoken);
    xSemaphoreGiveFromISR(xCountingSemaphore, &xHigherPriorityTaskWoken);
    xSemaphoreGiveFromISR(xCountingSemaphore, &xHigherPriorityTaskWoken);
    xSemaphoreGiveFromISR(xCountingSemaphore, &xHigherPriorityTaskWoken);

    NVIC_ClearPendingIRQ(EXTI15_10_IRQn);

    portEND_SWITCHING_ISR(xHigherPriorityTaskWoken);
}

