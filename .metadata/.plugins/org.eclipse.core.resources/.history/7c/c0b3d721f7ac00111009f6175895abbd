/**
 * @brief Thread-safe logging function for tasks.
 */
void printmsg(const char *msg)
{
    if (xLogStreamBuffer != NULL)
    {
        xStreamBufferSend(xLogStreamBuffer, msg, strlen(msg), portMAX_DELAY);
    }
}

/**
 * @brief Non-blocking, lock-free logging function for ISRs.
 */
void printmsgFromISR(const char *msg)
{
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;
    if (xLogStreamBuffer != NULL)
    {
        xStreamBufferSendFromISR(xLogStreamBuffer, msg, strlen(msg), &xHigherPriorityTaskWoken);
        portEND_SWITCHING_ISR(xHigherPriorityTaskWoken);
    }
}

/**
 * @brief Software/button interrupt setup
 */
static void prvSetupSoftwareInterrupt(void)
{
    NVIC_SetPriority(EXTI15_10_IRQn, configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY);
    NVIC_EnableIRQ(EXTI15_10_IRQn);
}
