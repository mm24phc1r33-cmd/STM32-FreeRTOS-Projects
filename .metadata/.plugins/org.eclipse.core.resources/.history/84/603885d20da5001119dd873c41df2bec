/* =========================================================
 *                  UART RX CALLBACK
 * =========================================================
 *
 * This function executes in interrupt context.
 *
 * Every received UART character is placed into q_data.
 *
 * When ENTER is received:
 *
 * '\n'
 *
 * the command handler task is notified.
 *
 * =========================================================
 */

void HAL_UART_RxCpltCallback(
    UART_HandleTypeDef *huart
)
{
    uint8_t dummy;

    BaseType_t xHigherPriorityTaskWoken =
        pdFALSE;


    /* Make sure callback is from USART2 */

    if (huart->Instance == USART2)
    {
        /* =====================================================
         *                  QUEUE UART DATA
         * =====================================================
         */

        if (!xQueueIsQueueFullFromISR(q_data))
        {
            xQueueSendFromISR(
                q_data,
                (void *)&user_data,
                &xHigherPriorityTaskWoken
            );
        }
        else
        {
            /*
             * If queue is full and ENTER arrives,
             * remove the oldest byte and insert ENTER.
             */

            if (user_data == '\n')
            {
                xQueueReceiveFromISR(
                    q_data,
                    (void *)&dummy,
                    &xHigherPriorityTaskWoken
                );

                xQueueSendFromISR(
                    q_data,
                    (void *)&user_data,
                    &xHigherPriorityTaskWoken
                );
            }
        }


        /* =====================================================
         *              NOTIFY COMMAND TASK
         * =====================================================
         */

        if (user_data == '\n')
        {
            xTaskNotifyFromISR(
                handle_cmd_task,
                0,
                eNoAction,
                &xHigherPriorityTaskWoken
            );
        }


        /* =====================================================
         *              RESTART UART RX
         * =====================================================
         */

        HAL_UART_Receive_IT(
            &huart2,
            (uint8_t *)&user_data,
            1
        );


        /* =====================================================
         *          YIELD IF REQUIRED
         * =====================================================
         */

        portYIELD_FROM_ISR(
            xHigherPriorityTaskWoken
        );
    }
}


