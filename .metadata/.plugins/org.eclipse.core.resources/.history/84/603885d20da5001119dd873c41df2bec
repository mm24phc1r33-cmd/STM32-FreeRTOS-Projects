/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
    /* USER CODE BEGIN 1 */

    /* USER CODE END 1 */


    /* MCU Configuration--------------------------------------------------------*/

    /*
     * Reset of all peripherals,
     * Initializes the Flash interface and the Systick.
     */

    HAL_Init();


    /* USER CODE BEGIN Init */

    /* USER CODE END Init */


    /* Configure the system clock */

    SystemClock_Config();


    /* USER CODE BEGIN SysInit */

    /* USER CODE END SysInit */


    /* Initialize all configured peripherals */

    MX_GPIO_Init();

    MX_RTC_Init();

    MX_USART2_UART_Init();


    /* USER CODE BEGIN 2 */


    /* =========================================================
     *                    CREATE QUEUES
     * =========================================================
     *
     * q_data:
     * Receives individual UART characters.
     *
     * q_print:
     * Receives pointers to strings that must be printed.
     *
     * =========================================================
     */

    q_data = xQueueCreate(
        10,
        sizeof(char)
    );

    configASSERT(q_data != NULL);


    q_print = xQueueCreate(
        10,
        sizeof(char *)
    );

    configASSERT(q_print != NULL);


    /* =========================================================
     *                    CREATE TASKS
     * =========================================================
     *
     * IMPORTANT:
     * Each task is created ONLY ONCE.
     *
     * =========================================================
     */


    /* MENU TASK */

    status = xTaskCreate(
        menu_task,
        "menu_task",
        250,
        NULL,
        2,
        &handle_menu_task
    );

    configASSERT(status == pdPASS);


    /* COMMAND HANDLER TASK */

    status = xTaskCreate(
        cmd_handler_task,
        "cmd_task",
        250,
        NULL,
        2,
        &handle_cmd_task
    );

    configASSERT(status == pdPASS);


    /* PRINT TASK */

    status = xTaskCreate(
        print_task,
        "print_task",
        250,
        NULL,
        2,
        &handle_print_task
    );

    configASSERT(status == pdPASS);


    /* LED TASK */

    status = xTaskCreate(
        led_task,
        "led_task",
        250,
        NULL,
        2,
        &handle_led_task
    );

    configASSERT(status == pdPASS);


    /* RTC TASK */

    status = xTaskCreate(
        rtc_task,
        "rtc_task",
        250,
        NULL,
        2,
        &handle_rtc_task
    );

    configASSERT(status == pdPASS);


    /* =========================================================
     *                  CREATE SOFTWARE TIMERS
     * =========================================================
     *
     * Four timers are created.
     *
     * Timer ID:
     *
     * 1 -> LED Effect 1
     * 2 -> LED Effect 2
     * 3 -> LED Effect 3
     * 4 -> LED Effect 4
     *
     * Timer period = 500 ms
     * Auto reload = pdTRUE
     *
     * =========================================================
     */

    for (int i = 0; i < 4; i++)
    {
        handle_led_timer[i] = xTimerCreate(
            "LED_TIMER",
            pdMS_TO_TICKS(500),
            pdTRUE,
            (void *)(uintptr_t)(i + 1),
            led_effect_callback
        );

        configASSERT(handle_led_timer[i] != NULL);
    }


    /* =========================================================
     *                  START UART RECEPTION
     * =========================================================
     *
     * UART receives one character at a time.
     *
     * When ENTER ('\n') is received,
     * HAL_UART_RxCpltCallback() notifies cmd_handler_task.
     *
     * =========================================================
     */

    HAL_UART_Receive_IT(
        &huart2,
        (uint8_t *)&user_data,
        1
    );


    /* =========================================================
     *                  START FREERTOS
     * =========================================================
     */

    vTaskStartScheduler();


    /*
     * Scheduler should never return here.
     */

    /* USER CODE END 2 */


    /* Infinite loop */

    while (1)
    {
        /*
         * Should never reach here because
         * FreeRTOS scheduler is running.
         */
    }
}


